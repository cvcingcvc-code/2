.records-hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 12rpx 6rpx 30rpx;
}

.records-hero-text {
    display: flex;
    flex-direction: column;
}

.records-title {
    display: block;
    margin-top: 14rpx;
    font-size: 46rpx;
    font-weight: 800;
    color: #182236;
}

.records-subtitle {
    display: block;
    margin-top: 10rpx;
    font-size: 25rpx;
    color: #7c879a;
}

.signout-button {
    display: flex;
    align-items: center;
    padding: 8rpx 16rpx;
    border-radius: 999rpx;
    background: #ffffff;
    color: #8a94a6;
    font-size: 22rpx;
}

.signout-button .icon-sm {
    width: 24rpx;
    height: 24rpx;
    margin-right: 6rpx;
}

.stats-card {
    display: flex;
    align-items: center;
    padding: 28rpx 16rpx;
    margin-bottom: 26rpx;
    border-radius: 24rpx;
    background: linear-gradient(120deg, #2f6bff 0%, #5b8bff 100%);
    box-shadow: 0 12rpx 28rpx rgba(47, 107, 255, 0.18);
}

.stat-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.stat-value {
    font-size: 42rpx;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
}

.stat-value-active {
    color: #eaf5ff;
}

.stat-label {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: rgba(255, 255, 255, 0.82);
}

.stat-divider {
    width: 2rpx;
    height: 48rpx;
    background: rgba(255, 255, 255, 0.28);
}

.record-card {
    padding: 26rpx;
    margin-bottom: 22rpx;
}

.record-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6rpx;
}

.record-title {
    flex: 1;
    margin-right: 16rpx;
    font-size: 30rpx;
    font-weight: 700;
    color: #182236;
}

.record-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 22rpx;
    padding-top: 18rpx;
    border-top: 2rpx solid #f0f2f7;
}

.record-time {
    font-size: 22rpx;
    color: #a3adbd;
}

.cancel-button {
    padding: 8rpx 22rpx;
    border: 2rpx solid #e6c9c5;
    border-radius: 999rpx;
    color: #c8443b;
    font-size: 23rpx;
}
