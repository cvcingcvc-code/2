.hero {
    padding: 12rpx 6rpx 30rpx;
}

.hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.session-chip {
    display: flex;
    align-items: center;
    padding: 6rpx 16rpx;
    border-radius: 999rpx;
    background: #e8f8f2;
    color: #0e9c70;
    font-size: 22rpx;
    font-weight: 600;
}

.session-icon {
    width: 24rpx;
    height: 24rpx;
    margin-right: 6rpx;
}

.hero-title {
    display: block;
    margin-top: 18rpx;
    font-size: 46rpx;
    font-weight: 800;
    line-height: 1.25;
    color: #182236;
}

.hero-subtitle {
    display: block;
    margin-top: 12rpx;
    font-size: 25rpx;
    color: #7c879a;
}

.login-slot {
    margin-bottom: 30rpx;
}

.section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin: 10rpx 4rpx 20rpx;
}

.refresh-button {
    display: flex;
    align-items: center;
    padding: 8rpx 16rpx;
    border-radius: 999rpx;
    background: #ffffff;
    color: #6d7a90;
    font-size: 23rpx;
}

.refresh-button .icon-sm {
    width: 24rpx;
    height: 24rpx;
    margin-right: 6rpx;
}

.activity-card {
    overflow: hidden;
    margin-bottom: 24rpx;
}

.cover {
    position: relative;
    width: 100%;
    height: 220rpx;
    background: #e9efff;
}

.cover-image {
    width: 100%;
    height: 220rpx;
    display: block;
}

.cover-placeholder {
    width: 100%;
    height: 220rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #dbe7ff 0%, #eef3ff 55%, #e6f0ff 100%);
}

.cover-mark {
    width: 62rpx;
    height: 62rpx;
    opacity: 0.7;
}

.cover-placeholder-text {
    margin-top: 10rpx;
    font-size: 22rpx;
    letter-spacing: 2rpx;
    color: #7d90bd;
}

.cover-tag {
    position: absolute;
    top: 18rpx;
    left: 18rpx;
    padding: 6rpx 18rpx;
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.94);
    color: #2f6bff;
    font-size: 21rpx;
    font-weight: 600;
}

.card-body {
    padding: 26rpx 26rpx 22rpx;
}

.card-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.card-title {
    flex: 1;
    margin-right: 16rpx;
    font-size: 32rpx;
    font-weight: 700;
    color: #182236;
}

.card-summary {
    display: block;
    margin-top: 8rpx;
    font-size: 25rpx;
    color: #7c879a;
}

.card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 22rpx;
    padding-top: 18rpx;
    border-top: 2rpx solid #f0f2f7;
}

.audience-chip {
    display: flex;
    align-items: center;
    padding: 6rpx 14rpx;
    border-radius: 10rpx;
    background: #f3f6fc;
    color: #6d7a90;
    font-size: 22rpx;
}

.audience-chip .icon-sm {
    width: 24rpx;
    height: 24rpx;
    margin-right: 8rpx;
}

.detail-link {
    display: flex;
    align-items: center;
    color: #2f6bff;
    font-size: 23rpx;
    font-weight: 600;
}

.detail-link .icon-sm {
    width: 24rpx;
    height: 24rpx;
    margin-left: 4rpx;
}

.tips-card {
    margin-top: 34rpx;
    padding: 28rpx;
    border-radius: 24rpx;
    background: #eef3ff;
}

.tips-title {
    display: block;
    font-size: 27rpx;
    font-weight: 700;
    color: #2a4fa8;
}

.tip-row {
    display: flex;
    align-items: center;
    margin-top: 16rpx;
}

.tip-index {
    width: 44rpx;
    font-size: 23rpx;
    font-weight: 700;
    color: #6c8cf0;
}

.tip-text {
    flex: 1;
    font-size: 24rpx;
    color: #51628a;
}
