.cover-wrap {
    position: relative;
    width: 100%;
    height: 340rpx;
    border-radius: 24rpx;
    overflow: hidden;
    background: #e9efff;
}

.cover-image {
    width: 100%;
    height: 340rpx;
    display: block;
}

.cover-placeholder {
    width: 100%;
    height: 340rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #d8e5ff 0%, #eef3ff 52%, #dfeeff 100%);
}

.cover-mark {
    width: 84rpx;
    height: 84rpx;
    opacity: 0.65;
}

.cover-placeholder-text {
    margin-top: 14rpx;
    font-size: 23rpx;
    letter-spacing: 3rpx;
    color: #7d90bd;
}

.cover-tag {
    position: absolute;
    top: 20rpx;
    left: 20rpx;
    padding: 6rpx 18rpx;
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.94);
    color: #2f6bff;
    font-size: 21rpx;
    font-weight: 600;
}

.cover-action {
    position: absolute;
    right: 20rpx;
    bottom: 20rpx;
    display: flex;
    align-items: center;
    padding: 10rpx 18rpx;
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.94);
    color: #2f6bff;
    font-size: 22rpx;
    font-weight: 600;
}

.cover-action .icon-sm {
    width: 26rpx;
    height: 26rpx;
    margin-right: 8rpx;
}

.info-card {
    margin-top: -26rpx;
    padding: 32rpx 28rpx 28rpx;
    position: relative;
}

.detail-title {
    flex: 1;
    margin-right: 16rpx;
    font-size: 36rpx;
    font-weight: 800;
    color: #182236;
}

.detail-summary {
    display: block;
    margin-top: 10rpx;
    font-size: 26rpx;
    color: #7c879a;
}

.divider {
    height: 2rpx;
    margin: 24rpx 0 8rpx;
    background: #f0f2f7;
}

.content-card {
    margin-top: 24rpx;
    padding: 30rpx 28rpx;
}

.desc-row {
    display: flex;
    align-items: flex-start;
    margin-top: 18rpx;
}

.desc-dot {
    width: 12rpx;
    height: 12rpx;
    margin-top: 14rpx;
    margin-right: 16rpx;
    border-radius: 50%;
    background: #9db9ff;
    flex-shrink: 0;
}

.desc-text {
    flex: 1;
    font-size: 26rpx;
    line-height: 1.7;
    color: #5b6678;
}

.notice-card {
    margin-top: 24rpx;
    padding: 28rpx;
    border-radius: 24rpx;
    background: #eef3ff;
}

.notice-head {
    display: flex;
    align-items: center;
    margin-bottom: 14rpx;
}

.notice-head .icon-sm {
    margin-right: 10rpx;
}

.notice-title {
    font-size: 27rpx;
    font-weight: 700;
    color: #2a4fa8;
}

.notice-line {
    display: block;
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #51628a;
}
