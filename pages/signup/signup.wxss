.form-hero {
    display: flex;
    flex-direction: column;
    padding: 12rpx 6rpx 28rpx;
}

.form-hero-title {
    display: block;
    margin-top: 14rpx;
    font-size: 44rpx;
    font-weight: 800;
    color: #182236;
}

.form-hero-subtitle {
    display: block;
    margin-top: 10rpx;
    font-size: 25rpx;
    color: #7c879a;
}

.activity-strip {
    display: flex;
    align-items: center;
    padding: 24rpx;
    margin-bottom: 24rpx;
}

.strip-icon {
    width: 52rpx;
    height: 52rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
}

.strip-body {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.strip-title {
    font-size: 29rpx;
    font-weight: 700;
    color: #182236;
}

.strip-meta {
    margin-top: 6rpx;
    font-size: 23rpx;
    color: #8a94a6;
}

.form-card {
    padding: 30rpx 28rpx;
}

.picker-value {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 84rpx;
    padding: 0 22rpx;
    border: 2rpx solid #e5eaf3;
    border-radius: 16rpx;
    background: #fbfcff;
    color: #1b2430;
    font-size: 28rpx;
}

.submit-button {
    margin-top: 34rpx;
}

.success-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48rpx 32rpx 34rpx;
    background: #ffffff;
    border: 2rpx solid #eef1f7;
    border-radius: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(31, 45, 79, 0.05);
}

.success-icon {
    width: 96rpx;
    height: 96rpx;
}

.success-title {
    margin-top: 18rpx;
    font-size: 38rpx;
    font-weight: 800;
    color: #182236;
}

.success-subtitle {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #8a94a6;
    text-align: center;
}

.success-divider {
    width: 100%;
    height: 2rpx;
    margin: 30rpx 0 8rpx;
    background: #f0f2f7;
}

.success-row {
    display: flex;
    align-items: flex-start;
    width: 100%;
    margin-top: 18rpx;
}

.success-label {
    width: 150rpx;
    color: #8a94a6;
    font-size: 25rpx;
}

.success-value {
    flex: 1;
    color: #3a4658;
    font-size: 26rpx;
    font-weight: 600;
}

.success-primary {
    margin-top: 32rpx;
}

.success-secondary {
    margin-top: 20rpx;
}
