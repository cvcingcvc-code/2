page {
    min-height: 100%;
    background: #f4f6fb;
    color: #1b2430;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
    font-size: 28rpx;
    line-height: 1.55;
}

view, text, input, textarea, button, image {
    box-sizing: border-box;
}

button {
    border-radius: 16rpx;
    font-size: 29rpx;
}

button::after {
    border: none;
}

.page-shell {
    min-height: 100vh;
    padding: 28rpx 28rpx 64rpx;
}

.page-shell-tab {
    padding-bottom: 152rpx;
}

.card {
    background: #ffffff;
    border: 2rpx solid #eef1f7;
    border-radius: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(31, 45, 79, 0.05);
}

.section-title {
    font-size: 30rpx;
    font-weight: 700;
    color: #1b2430;
}

.section-subtitle {
    margin-top: 6rpx;
    font-size: 24rpx;
    color: #8a94a6;
}

.muted {
    color: #8a94a6;
}

.eyebrow {
    font-size: 21rpx;
    font-weight: 700;
    letter-spacing: 3rpx;
    color: #2f6bff;
}

.pill {
    display: inline-flex;
    align-items: center;
    padding: 4rpx 16rpx;
    border-radius: 999rpx;
    background: #eef3ff;
    color: #2f6bff;
    font-size: 22rpx;
    font-weight: 600;
}

.pill-success {
    display: inline-flex;
    align-items: center;
    padding: 4rpx 16rpx;
    border-radius: 999rpx;
    background: #e8f8f2;
    color: #0e9c70;
    font-size: 22rpx;
    font-weight: 600;
}

.pill-muted {
    display: inline-flex;
    align-items: center;
    padding: 4rpx 16rpx;
    border-radius: 999rpx;
    background: #f1f3f7;
    color: #8a94a6;
    font-size: 22rpx;
    font-weight: 600;
}

.meta-row {
    display: flex;
    align-items: center;
    margin-top: 12rpx;
}

.meta-icon {
    width: 30rpx;
    height: 30rpx;
    margin-right: 12rpx;
    flex-shrink: 0;
    opacity: 0.85;
}

.meta-text {
    flex: 1;
    font-size: 25rpx;
    color: #5b6678;
}

.icon-sm {
    width: 28rpx;
    height: 28rpx;
    flex-shrink: 0;
}

.row-between {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.state-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 64rpx 36rpx;
    background: #ffffff;
    border: 2rpx solid #eef1f7;
    border-radius: 24rpx;
}

.state-icon {
    width: 72rpx;
    height: 72rpx;
    margin-bottom: 20rpx;
    opacity: 0.75;
}

.state-title {
    font-size: 30rpx;
    font-weight: 700;
}

.state-description {
    margin-top: 10rpx;
    font-size: 25rpx;
    color: #8a94a6;
    text-align: center;
}

.retry-button {
    margin-top: 28rpx;
    padding: 0 44rpx;
    height: 72rpx;
    line-height: 72rpx;
    border-radius: 999rpx;
    background: #eef3ff;
    color: #2f6bff;
    font-size: 26rpx;
    font-weight: 600;
}

.primary-button {
    height: 92rpx;
    line-height: 92rpx;
    border-radius: 20rpx;
    background: #2f6bff;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
    letter-spacing: 1rpx;
}

.primary-button[disabled] {
    background: #a9c0ff;
    color: #ffffff;
}

.ghost-button {
    height: 92rpx;
    line-height: 92rpx;
    border-radius: 20rpx;
    background: #eef3ff;
    color: #2f6bff;
    font-size: 30rpx;
    font-weight: 600;
}

.error-banner {
    margin-bottom: 22rpx;
    padding: 18rpx 22rpx;
    border-radius: 16rpx;
    background: #fff2f1;
    border: 2rpx solid #ffded9;
}

.error-banner-text {
    font-size: 25rpx;
    color: #c8443b;
}

.field-card {
    margin-top: 24rpx;
}

.field-label {
    display: block;
    margin-bottom: 12rpx;
    font-size: 26rpx;
    font-weight: 600;
    color: #3a4658;
}

.required {
    color: #e05252;
}

.field-input,
.field-textarea {
    width: 100%;
    border: 2rpx solid #e5eaf3;
    border-radius: 16rpx;
    padding: 20rpx 22rpx;
    background: #fbfcff;
    color: #1b2430;
    font-size: 28rpx;
}

.field-textarea {
    min-height: 150rpx;
}

.field-card-error .field-input,
.field-card-error .field-textarea {
    border-color: #f3b4ae;
    background: #fffafa;
}

.field-error {
    display: block;
    margin-top: 8rpx;
    font-size: 23rpx;
    color: #d25045;
}

.field-hint {
    display: block;
    margin-top: 16rpx;
    font-size: 22rpx;
    color: #98a2b3;
}

.bottom-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 20rpx;
    padding: 18rpx 28rpx 18rpx;
    padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
    background: #ffffff;
    border-top: 2rpx solid #eef1f7;
}

.bottom-bar .primary-button,
.bottom-bar .ghost-button {
    flex: 1;
}

.with-bottom-bar {
    padding-bottom: 180rpx;
}
